      "item": [
        {
          "name": "Retrieve airport codes",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Specific Test 1: Verify airport list array structure\npm.test(\"Response returns array with airport data\", function () {\n    const jsonData = pm.response.json();\n    pm.expect(jsonData).to.be.an(\"array\");\n    pm.expect(jsonData[0]).to.have.property(\"country\");\n    pm.expect(jsonData[0]).to.have.property(\"airports\");\n    pm.expect(jsonData[0].airports[0]).to.have.property(\"code\");\n});\n\n// Specific Test 2: Verify airport code query match\npm.test(\"Response contains requested airport code\", function () {\n    const jsonData = pm.response.json();\n    const airportCodes = jsonData[0].airports.map(a => a.code);\n    pm.expect(airportCodes).to.include(\"ATL\");\n});"
                ]
              }
            }
          ],
